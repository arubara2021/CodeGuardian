# Environment variable template. Copy to .env and fill in the values you need.
# Every variable here is optional. API keys belong in the OS keychain; the
# environment variables exist as a fallback for CI environments that have no
# keychain, and they override the keychain if both are set.

# Override the default configuration file location.
# CODEGUARDIAN_CONFIG=/absolute/path/to/config.toml

# Override the default data directory, which is ~/.codeguardian.
# CODEGUARDIAN_HOME=/absolute/path/to/data

# Log level: debug, info, warning, error. Default is info.
# CODEGUARDIAN_LOG_LEVEL=info

# Sandbox backend: auto, bubblewrap, seatbelt, firecracker, docker.
# Default is auto, which chooses by platform and available tooling.
# CODEGUARDIAN_SANDBOX_BACKEND=auto

# Cloud model provider keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# LangSmith tracing is disabled unless LANGSMITH_TRACING is true and
# LANGSMITH_API_KEY is set.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=codeguardian
